{
  "libraries_file": "libraries.txt",
  "download_dir": "downloads",
  "history_file": "state/history.json",
  "library_id": "",
  "search_path": "/opds/search/{searchTerms}",
  "auto_discover": true,
  "opds_path": "/opds",
  "preferred_formats": [
    "mobi",
    "epub",
    "azw3",
    "azw",
    "pdf"
  ],
  "timeout": 10,
  "retries": 1,
  "max_pages": 10,
  "max_results": 100,
  "max_download_bytes": 100000000,
  "prune_timeouts": true,
  "allowed_hosts": [],
  "username_env": "CALIBRE_USERNAME",
  "password_env": "CALIBRE_PASSWORD",
  "catalog_cache_enabled": false,
  "catalog_refresh_interval_hours": 24,
  "catalog_cache_dir": "state/catalogs",
  "catalog_max_pages": 10000,
  "catalog_max_books": 500000,
  "catalog_request_delay": 0.25,
  "catalog_cache_covers": false,
  "catalog_library_timeout_seconds": 3600,
  "catalog_checkpoint_max_age_hours": 72,
  "catalog_scan_concurrency": 2,
  "library_download_timeout_limit": 3,
  "library_scan_failure_limit": 3,
  "verify_tls": true
}
